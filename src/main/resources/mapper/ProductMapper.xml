<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.demo.mapper.ProductMapper">

  <select id="findAll" resultType="com.example.demo.entity.Product">
    SELECT id, name, price
    FROM products
    ORDER BY id
  </select>

  <select id="findById" resultType="com.example.demo.entity.Product">
    SELECT id, name, price
    FROM products
    WHERE id = #{id}
  </select>

  <select id="findByCategoryId" resultType="com.example.demo.entity.Product">
    SELECT * 
    FROM products 
    WHERE category_id = #{categoryId}
  </select>

  <select id="findByRegionId" resultType="com.example.demo.entity.Product">
    SELECT * 
    FROM products 
    WHERE region_id = #{regionId}
  </select>

  <select id="findByRegionIdAndCategoryId" resultType="com.example.demo.entity.Product">
    SELECT * 
    FROM products
    WHERE region_id = #{regionId} AND category_id = #{categoryId}
  </select>

</mapper>